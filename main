let castChartInstance = null;
let intensityChartInstance = null;

function switchTab(tabId) {
    // Hide all sections
    const sections = ['sec-ringkasan', 'sec-kostum', 'sec-koreografi', 'sec-teknis', 'sec-backstage', 'sec-risiko', 'sec-analisis'];
    sections.forEach(id => {
        document.getElementById(id).classList.add('hidden');
    });
    
    // Reset all nav buttons
    const navIds = ['nav-ringkasan', 'nav-kostum', 'nav-koreografi', 'nav-teknis', 'nav-backstage', 'nav-risiko', 'nav-analisis'];
    navIds.forEach(id => {
        document.getElementById(id).className = 'tab-inactive px-6 py-4 text-sm md:text-base whitespace-nowrap transition-colors cursor-pointer';
    });
    
    // Show selected section & activate tab
    document.getElementById('sec-' + tabId).classList.remove('hidden');
    document.getElementById('nav-' + tabId).className = 'tab-active px-6 py-4 text-sm md:text-base whitespace-nowrap transition-colors cursor-pointer';

    // Init charts if needed
    if(tabId === 'analisis' && !castChartInstance) {
        initCharts();
    }
}

function renderTimeline() {
    const container = document.getElementById('timeline-container');
    container.innerHTML = '';
    
    cueData.forEach((babak, index) => {
        const btn = document.createElement('button');
        btn.id = 'btn-babak-' + babak.id;
        btn.className = 'px-4 py-2 rounded-md font-semibold text-sm transition-all duration-300 ' + (index === 0 ? 'timeline-btn-active' : 'timeline-btn-inactive');
        btn.innerText = 'Babak ' + babak.id;
        btn.onclick = () => loadBabakDetail(babak.id);
        container.appendChild(btn);
    });
    
    loadBabakDetail(1);
}

function loadBabakDetail(id) {
    cueData.forEach(b => {
        const btn = document.getElementById('btn-babak-' + b.id);
        if(btn) {
            btn.className = 'px-4 py-2 rounded-md font-semibold text-sm transition-all duration-300 ' + (b.id === id ? 'timeline-btn-active shadow-md' : 'timeline-btn-inactive hover:bg-stone-300');
        }
    });

    const data = cueData.find(b => b.id === id);
    if(data) {
        document.getElementById('detail-title').innerText = data.title;
        document.getElementById('detail-time').innerText = "Waktu: " + data.time;
        document.getElementById('detail-lighting').innerHTML = data.lighting;
        document.getElementById('detail-sound').innerHTML = data.sound;
        document.getElementById('detail-crew').innerHTML = data.crew;
        document.getElementById('detail-grup').innerHTML = data.grup;
        
        const card = document.getElementById('cue-detail-card');
        card.classList.remove('animate-pulse');
        void card.offsetWidth; 
        card.classList.add('animate-pulse');
        setTimeout(() => { card.classList.remove('animate-pulse'); }, 500);
    }
}

function initCharts() {
    const ctxCast = document.getElementById('castChart').getContext('2d');
    castChartInstance = new Chart(ctxCast, {
        type: 'doughnut',
        data: {
            labels: ['Karakter Utama (12)', 'Ensemble (300)'],
            datasets: [{
                data: [12, 300],
                backgroundColor: ['#d97706', '#fcd34d'],
                borderWidth: 0,
                hoverOffset: 10
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });

    const ctxIntensity = document.getElementById('intensityChart').getContext('2d');
    intensityChartInstance = new Chart(ctxIntensity, {
        type: 'bar',
        data: {
            labels: ['Babak 1', 'Babak 2', 'Babak 3', 'Babak 4', 'Babak 5'],
            datasets: [
                {
                    label: 'Lighting Cues',
                    data: [5, 2, 4, 9, 7],
                    backgroundColor: '#fbbf24',
                    borderRadius: 4
                },
                {
                    label: 'Sound & SFX Cues',
                    data: [6, 3, 5, 10, 6],
                    backgroundColor: '#60a5fa',
                    borderRadius: 4
                },
                {
                    label: 'Prop/Crew Gerak',
                    data: [4, 3, 3, 9, 8],
                    backgroundColor: '#f87171',
                    borderRadius: 4
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    max: 10,
                    title: { display: true, text: 'Kompleksitas' }
                }
            },
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
}

